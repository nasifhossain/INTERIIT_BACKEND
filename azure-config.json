{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "webAppName": {
      "value": "interiit-backend"
    },
    "location": {
      "value": "eastus"
    },
    "sku": {
      "value": "B1"
    },
    "nodeVersion": {
      "value": "20-lts"
    },
    "appSettings": [
      {
        "name": "NODE_ENV",
        "value": "production"
      },
      {
        "name": "WEBSITE_NODE_DEFAULT_VERSION",
        "value": "~20"
      },
      {
        "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
        "value": "true"
      },
      {
        "name": "JWT_EXPIRES_IN",
        "value": "7d"
      }
    ],
    "alwaysOn": {
      "value": true
    },
    "healthCheckPath": {
      "value": "/health"
    }
  }
}
